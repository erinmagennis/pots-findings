cff-version: 1.2.0
title: "POTS / Dysautonomia Literature Findings"
message: "If you use this dataset, please cite it AND the original papers behind any finding you rely on."
type: dataset
authors:
  - family-names: "Magennis"
    given-names: "Erin"
version: v1.2
date-released: "2026-10-22"
license: CC-BY-4.0
repository-code: "https://github.com/erinmagennis/pots-findings"
url: "https://pots.erinmagennis.com"
keywords: [dysautonomia, ehlers-danlos, research-findings, open-data]
abstract: >-
  148,186 structured research findings machine-extracted from 11,519 papers (published 2019 to 2026)
  on POTS, dysautonomia and related conditions, in five data packages, each with a verbatim source quote. In v1.2
  every model-written ontology identifier was checked at its authority; 19,782 rows carry a verified identifier.
  Scientific fidelity has not yet been checked by a human reader. Verbatim quoted text remains the copyright of its
  authors and publishers.
references:
  - type: software
    title: "condition-findings-builder"
    authors:
      - family-names: "Magennis"
        given-names: "Erin"
    repository-code: "https://github.com/erinmagennis/condition-findings-builder"
